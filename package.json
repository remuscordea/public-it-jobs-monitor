{
  "name": "public-it-jobs-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Monitor pentru anunturi IT publicate de institutii publice din Romania.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "check": "tsx src/index.ts --dry-run",
    "diagnose": "tsx src/diagnose.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
